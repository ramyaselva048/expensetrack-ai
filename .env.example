# ==============================================================================
# ExpenseTrack - Environment Configuration Template
# Copy this file to '.env' and fill in your actual production/local credentials.
# WARNING: NEVER commit your actual '.env' file containing real secrets to Git.
# ==============================================================================

# Server Network Configuration
PORT=3000
NODE_ENV=production

# MySQL / MariaDB Database Connection
# Supported by local MySQL, Cloud SQL, AWS RDS, TiDB Cloud, PlanetScale, Railway, Render, Aiven, etc.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_db_username
DB_PASSWORD=your_db_password
DB_NAME=expensetrack_db
DB_SSL=false

# Security & Authentication
# Generate a strong random string (e.g. openssl rand -base64 32)
JWT_SECRET=your_jwt_secret_key_change_me_in_production

# Client-Side API Configuration (Optional)
# Leave blank for default same-origin /api (recommended for single-server/monolith deploy).
# Set only if frontend is hosted on a separate CDN/domain from backend (e.g. Vercel -> Railway).
VITE_API_URL=

# AI & Gemini API Configuration (Optional)
GEMINI_API_KEY=
